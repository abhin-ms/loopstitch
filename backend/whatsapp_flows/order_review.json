{
  "version": "7.3",
  "screens": [
    {
      "id": "REVIEW",
      "title": "Rate your order",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "How was your Loopstitch order?"
          },
          {
            "type": "TextBody",
            "text": "Your feedback helps us make better tees."
          },
          {
            "type": "TextBody",
            "markdown": true,
            "text": "📸 **Upload a photo of your order and get 20% off your next purchase!**"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "rating",
            "label": "Your rating",
            "required": true,
            "data-source": [
              {
                "id": "5",
                "title": "★★★★★",
                "description": "Loved it"
              },
              {
                "id": "4",
                "title": "★★★★☆",
                "description": "Liked it"
              },
              {
                "id": "3",
                "title": "★★★☆☆",
                "description": "It was okay"
              },
              {
                "id": "2",
                "title": "★★☆☆☆",
                "description": "Not great"
              },
              {
                "id": "1",
                "title": "★☆☆☆☆",
                "description": "Disappointed"
              }
            ]
          },
          {
            "type": "TextArea",
            "name": "feedback",
            "label": "Your feedback",
            "helper-text": "Fit, fabric, print, delivery – tell us anything",
            "required": false,
            "max-length": 600
          },
          {
            "type": "Footer",
            "label": "Next: add photos",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "PHOTOS"
              },
              "payload": {
                "rating": "${form.rating}",
                "feedback": "${form.feedback}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "PHOTOS",
      "title": "Add photos",
      "terminal": true,
      "success": true,
      "data": {
        "rating": {
          "type": "string",
          "__example__": "5"
        },
        "feedback": {
          "type": "string",
          "__example__": "Great fit!"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Upload a photo, get 20% off"
          },
          {
            "type": "TextBody",
            "text": "Add a photo of your order and we'll WhatsApp you a 20% discount code for your next purchase. Photos are optional – you can submit without them."
          },
          {
            "type": "PhotoPicker",
            "name": "photos",
            "label": "Take or choose photos",
            "description": "Use your camera or pick from your gallery. Up to 3 photos.",
            "photo-source": "camera_gallery",
            "min-uploaded-photos": 0,
            "max-uploaded-photos": 3,
            "max-file-size-kb": 10240
          },
          {
            "type": "Footer",
            "label": "Submit review",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "rating": "${data.rating}",
                "feedback": "${data.feedback}",
                "photos": "${form.photos}"
              }
            }
          }
        ]
      }
    }
  ]
}
