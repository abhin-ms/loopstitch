# Copy this file to .env and fill in real values before deploying.
# For local testing, none of these are required — SQLite + defaults just work.

# Uncomment to use MySQL/MariaDB (e.g. on your aaPanel VPS) instead of SQLite:
# DATABASE_URL=mysql+pymysql://loopstitch_user:password@localhost:3306/loopstitch

# Change this to a long random string in production:
SECRET_KEY=change-this-to-a-long-random-string

# Comma-separated list of frontend origins allowed to call this API:
CORS_ORIGINS=http://localhost:5173,https://loopstitch.online,https://www.loopstitch.online

# Razorpay payment gateway credentials:
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Razorpay Dashboard -> Webhooks: URL https://loopstitch.online/api/webhooks/razorpay,
# events payment.captured + order.paid, and the same secret here:
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Unpaid online / COD-advance orders give their stock back after this many minutes:
ORDER_PAYMENT_TIMEOUT_MINUTES=30

# WhatsApp Business Cloud API (Meta Cloud API):
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_API_VERSION=v23.0
# Meta app -> WhatsApp -> Configuration: the verify token you type there, and the app secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=pick_a_long_random_string
WHATSAPP_APP_SECRET=your_meta_app_secret
# Store-wide ceiling on WhatsApp OTPs sent per hour (protects the WhatsApp bill from bots)
OTP_HOURLY_CAP=200

# Delhivery (automatic pickups). Keep the real token only in the server's .env
DELHIVERY_API_TOKEN=your_delhivery_api_token
# Staging: https://staging-express.delhivery.com
DELHIVERY_BASE_URL=https://track.delhivery.com
WHATSAPP_SHIPPED_TEMPLATE=order_shipped
